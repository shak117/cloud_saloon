# ==============================================================================
# Cloud Salon Backend - Environment Variables Example
# Copy this file to '.env' and populate with your environment's values.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/cloud_billing
DB_SCHEMA=salon

# Security & JWT (Generate a secure random string: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=8001
HOST=127.0.0.1
PROJECT_NAME="Cloud Salon API"
COMPANY_NAME="Cloud Technologies"
PILOT_TENANT_ID="sk-relax-satara"
