# ==============================================================================
# Cloud Salon SaaS - Root Environment Configuration Template
# For local development: copy to backend/.env and update values.
# For Docker Compose: copy to .env in project root.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=cloudbilling
POSTGRES_PASSWORD=replace_with_secure_database_password
POSTGRES_DB=cloud_billing
DATABASE_URL=postgresql+psycopg://cloudbilling:replace_with_secure_database_password@localhost:5432/cloud_billing
DB_SCHEMA=salon

# JWT & Security Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_character_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
ENVIRONMENT=development
PORT=8001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend Configuration
VITE_BACKEND_PORT=8001

# Tenant & Project Identifiers
PROJECT_NAME="Cloud Salon API"
COMPANY_NAME="Cloud Technologies"
PILOT_TENANT_ID="sk-relax-satara"
